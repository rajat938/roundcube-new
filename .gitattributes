# Shell scripts and configs must keep Linux line endings (LF), even
# when the repo is checked out on Windows.
*.sh        text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
Caddyfile*  text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.env       text eol=lf
.env.example text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
