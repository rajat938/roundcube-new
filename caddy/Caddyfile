# HTTPS front door for the account manager (8443) and webmail (8444).
#
# Default: https://<server-ip>:8443 with a certificate Caddy makes itself
# (browser shows a one-time warning; traffic is still fully encrypted).
#
# With a domain (e.g. admin.asituj.com pointing to this server):
#   set ADMIN_SITE=admin.asituj.com in .env, publish ports 80 and 443 for
#   the caddy service, and Caddy gets a free Let's Encrypt certificate.
{
	admin off
}

{$ADMIN_SITE::8443} {
	tls {$ADMIN_TLS:internal} {
		on_demand
	}
	encode gzip
	header -Server
	reverse_proxy account-manager:5000
}

# Webmail (Roundcube) over HTTPS -- plain HTTP 8081 is only open on the
# server itself now.
{$WEBMAIL_SITE::8444} {
	tls {$ADMIN_TLS:internal} {
		on_demand
	}
	encode gzip
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy roundcube:80
}
