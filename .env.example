# .env -- SECRETS ONLY. Lives next to docker-compose.yml, NEVER in git
# (it is listed in .gitignore). docker compose reads it automatically and
# hands each container only the values it needs.

# --- Database ---------------------------------------------------------
DB_USER=roundcube
DB_PASSWORD=change-me
DB_NAME=roundcubemail
MYSQL_ROOT_PASSWORD=change-me-too

# --- Roundcube ----------------------------------------------------------
# Was $config['des_key'] in www/config/config.inc.php -- move it here.
# 24 characters. Changing it logs everyone out and makes ident_switch
# identities ask for their passwords again.
ROUNDCUBE_DES_KEY=change-me-24-characters!

# --- Admin page login (generate with: docker compose run --rm account-manager python3 /app/app.py setup)
# KEEP THE SINGLE QUOTES -- the hash contains $ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='paste-from-setup'
SECRET_KEY='paste-from-setup'

# --- Paths / sites --------------------------------------------------------
# Absolute path of the local mail mirror (recommended), e.g. /srv/mail/maildir
MAILDIR_PATH=./mail-mirror/maildir
# Leave empty for https://<server-ip>:8443 (admin) and :8444 (webmail),
# or set domains -- see caddy/Caddyfile.domain
ADMIN_SITE=
WEBMAIL_SITE=
