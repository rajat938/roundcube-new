# sync.env -- sync + admin-page SETTINGS (no secrets; safe to commit)

# --- Sync behaviour (all optional, defaults shown) -------------------
# Hostinger deleted a message from INBOX -> delete the local copy too?
# 0 = keep the local copy (nothing is ever deleted anywhere)
DELETE_LOCAL_ON_REMOTE_DELETE=0
# More than this many at once is held until confirmed (GUARD_CONFIRM_MINUTES)
# or approved. Removed local copies go to Roundcube's Trash, not deleted.
REMOTE_DELETE_MAX_PER_PASS=20

# Folder names (match Hostinger's "INBOX." naming)
SENT_FOLDER=INBOX.Sent
DRAFTS_FOLDER=INBOX.Drafts
TRASH_FOLDER=INBOX.Trash

# --- Drafts ------------------------------------------------------------
# 1 = drafts sync both ways (Roundcube <-> Hostinger/phone)
SYNC_DRAFTS=1
# When a draft is edited or sent, what happens to its OLD Hostinger copy:
#   trash  = moved to Hostinger's Trash (default -- nothing is ever
#            permanently deleted on Hostinger)
#   remove = removed, but only if sync-push uploaded that copy itself
# A draft you DELETE in Roundcube always goes to Hostinger's Trash.
DRAFT_OLD_VERSIONS=trash
# If more drafts than this disappear from Roundcube in one go, moving
# their Hostinger copies to Trash waits for "Approve" in the admin page
# (protects against an empty/restored local mail folder). New, edited
# and sent drafts keep syncing meanwhile.
DRAFT_MASS_DELETE_LIMIT=3
# Drafts disappearing from Hostinger (phone): up to this many at once are
# applied immediately; more than this (and more than half) is held.
DRAFT_VANISH_LIMIT=3
# A held bulk delete FROM Hostinger that is still true after this many
# minutes is treated as real and applied (local copies -> Roundcube Trash).
# You can also press Approve in the admin page to apply it at once.
GUARD_CONFIRM_MINUTES=15

# How quickly Start/Stop from the admin page is picked up (seconds)
ACCOUNT_RELOAD_INTERVAL=10

# How often push checks the LOCAL mirror for changes (cheap, local only)
PUSH_POLL_SECONDS=3
# Safety check of INBOX besides IDLE, and of other folders
INBOX_CHECK_SECONDS=30
OTHER_FOLDERS_SECONDS=60
FOLDER_DISCOVERY_SECONDS=600
# Only used if Hostinger lacks CONDSTORE: full flag rescan interval
FLAG_RESCAN_SECONDS=300

# --- Security -------------------------------------------------------
# Keep ON in production (Hostinger has a valid certificate)
REMOTE_TLS_VERIFY=1
# The only server(s) a Hostinger password is ever sent to (comma list)
REMOTE_ALLOWED_HOSTS=imap.hostinger.com
LOG_LEVEL=INFO

# --- Admin page login tuning -------------------------------------------
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILS_PER_IP=5
LOGIN_MAX_FAILS_TOTAL=30
LOGIN_LOCK_MINUTES=15
